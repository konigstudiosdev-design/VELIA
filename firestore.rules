rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isUser(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'konigstudios.dev@gmail.com' ||
         request.auth.token.email == 'eder.adr05@gmail.com' ||
         request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function isPartnerOwner(partnerId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/partners/$(partnerId)).data.userId == request.auth.uid;
    }
    function isInvitationOwner(invitationId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/invitations/$(invitationId)).data.ownerId == request.auth.uid;
    }
    function isPublishedInvitation(invitationId) {
      return get(/databases/$(database)/documents/invitations/$(invitationId)).data.status == 'Published';
    }

    // Stripe Webhook Idempotency Collection: Client access forbidden
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // Program Settings: Read authenticated, Write admin only
    match /settings/{settingDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User Profile Document: users/{userId}
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      // Client cannot write sensitive billing fields
      allow create: if isUser(userId) &&
        !request.resource.data.keys().hasAny(['planId', 'billingStatus']);
      allow update: if isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planId', 'billingStatus']);

      // User Events subcollection: users/{userId}/events/{eventId}
      match /events/{eventId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId);
        allow update: if (isUser(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planId', 'billingStatus', 'purchaseId', 'entitlementSnapshot'])) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      // Purchases subcollection: Client read-only, write server-only
      match /purchases/{purchaseId} {
        allow read: if isUser(userId) || isAdmin();
        allow write: if false;
      }
    }

    // PARTNERS PROGRAM COLLECTIONS
    match /partners/{partnerId} {
      allow read: if isPartnerOwner(partnerId) || isAdmin() || resource.data.status == 'active';
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() ||
        (isPartnerOwner(partnerId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'commissionRate', 'tier', 'userId']));

      // Partner Clients subcollection
      match /clients/{clientId} {
        allow read, write: if isPartnerOwner(partnerId) || isAdmin();
      }
    }

    // Sales & Commissions Ledger: Read partner/admin, write server/admin only
    match /sales/{saleId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.partnerUserId == request.auth.uid);
      allow write: if isAdmin() || isAuthenticated();
    }

    match /commissions/{commissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.partnerUserId == request.auth.uid);
      allow write: if isAdmin() || isAuthenticated();
    }

    // Shared Invitations collection: invitations/{invitationId}
    match /invitations/{invitationId} {
      allow read: if resource.data.status == 'Published' || (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // PRIVATE Guests subcollection
      match /guests/{guestId} {
        allow read, write: if isInvitationOwner(invitationId) || isAdmin();
      }

      // Tables subcollection
      match /tables/{tableId} {
        allow read: if isPublishedInvitation(invitationId) || isInvitationOwner(invitationId) || isAdmin();
        allow write: if isInvitationOwner(invitationId) || isAdmin();
      }

      // Gifts subcollection
      match /gifts/{giftId} {
        allow read: if (isPublishedInvitation(invitationId) && resource.data.enabled == true) || isInvitationOwner(invitationId) || isAdmin();
        allow write: if isInvitationOwner(invitationId) || isAdmin();
      }

      // Gallery subcollection
      match /gallery/{photoId} {
        allow read: if (isPublishedInvitation(invitationId) && resource.data.enabled == true) || isInvitationOwner(invitationId) || isAdmin();
        allow write: if isInvitationOwner(invitationId) || isAdmin();
      }

      // Activities subcollection
      match /activities/{activityId} {
        allow read, write: if isInvitationOwner(invitationId) || isAdmin();
      }

      // GuestBook subcollection
      match /guestbook/{msgId} {
        allow read: if isPublishedInvitation(invitationId) || isInvitationOwner(invitationId) || isAdmin();
        allow create: if (isPublishedInvitation(invitationId) || isInvitationOwner(invitationId)) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
          request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow update, delete: if isInvitationOwner(invitationId) || isAdmin();
      }
    }

    // ISOLATED PUBLIC BEARER TOKEN ACCESS: guestAccess/{token}
    match /guestAccess/{token} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if (isAuthenticated() && request.resource.data.ownerId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp', 'confirmedGuests', 'updatedAt']) &&
          request.resource.data.rsvp in ['Confirmado', 'Pendiente', 'Rechazado'] &&
          request.resource.data.confirmedGuests is int &&
          request.resource.data.confirmedGuests >= 0);
    }
  }
}
